# ============================================================
# 问月塔罗 · Git 忽略文件
# ============================================================

# ---- 依赖 ----
node_modules/
.pnp
.pnp.js
.yarn/install-state.gz

# ---- 构建产物 ----
dist/
dist-ssr/
build/
output/
out/
*.local

# ---- Vite / Vitest ----
.vite/
coverage/

# ---- Editor / IDE ----
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
Thumbs.db

# ---- Logs ----
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---- 环境变量 ----
.env
.env.*
!.env.example

# ---- Android / Gradle (Capacitor) ----
# Gradle 构建中间产物
android/.gradle/
android/build/
android/app/build/
android/capacitor-cordova-android-plugins/build/
android/**/*.iml
android/.idea/
android/local.properties
android/captures/
android/.externalNativeBuild/
android/.cxx/

# Gradle wrapper jar 通常可提交，但有时团队不提交 -> 这里保留提交（安全）
# android/gradle/wrapper/gradle-wrapper.jar

# 签名密钥（敏感，绝对不能提交）
*.jks
*.keystore
*.p12
*.pfx
# ---- macOS / Windows / Linux 杂项 ----
.DS_Store
.AppleDouble
.LSOverride
$RECYCLE.BIN/

# ---- 临时构建脚本（本次运行产生的临时 cjs） ----
.build-*.cjs
.verify-*.cjs
